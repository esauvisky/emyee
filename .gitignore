############################################################
## Global gitignore. Try not to add too many things here! ##
############################################################
# This thing
.DS_Store

# This other thing
MANIFEST

# vscode Stuff
.vscode/*

# Virtual Environments
.env
.venv
.cache-*
.aider*

# Python
__pycache__/
*.py[cod]

# Editor/tool scratch
.history/

# Generated at runtime — regenerated on every run, and secret besides
.cache
*tokens.json
analysis.json
recordings/
